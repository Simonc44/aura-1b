# ═══════════════════════════════════════════════════════════════════════
#  AURA ENGINE FORMAT (.aef) — Blueprint complet du systeme Aura-1B
#  Architecture, regles et configuration pour reproduire le systeme.
#  (Les poids neuronaux restent dans le GGUF : format texte = blueprint.)
# ═══════════════════════════════════════════════════════════════════════

[meta]
version = "0.5.0"
nom = "Aura-1B"
type = "MoE neuro-symbolique autonome, CPU-native"
description = "IA hybride : filtre instantane (niveau 0) + Llama 3.2 1B (GGUF) + PGS + DuckDuckGo + auto-amelioration"
auteur = "Simon"
licence = "MIT"
date = "2026-09-16"
dependances_externes = []  # AUCUNE API cloud : systeme 100% local

[architecture]
paradigme = "Pipeline a niveaux + MoE neuro-symbolique"
principe_cpu_native = "La reponse la plus rapide est celle qu'on ne genere pas : les niveaux 0 traitent ~60-70% des questions sans toucher au LLM (composant le plus lent a ~14 tok/s)."
type_routing = "TF-IDF + LogisticRegression (150 exemples) + cosinus prototypes"
type_symbolique = "Programmation Genetique Symbolique (gplearn)"
type_web = "DuckDuckGo RAG (sans cle API)"
type_apprentissage = "RAG sur corrections + cache semantique des reponses"
langues = ["fr", "en"]
parametres_total = "1 238 000 000"  # Llama 3.2 1.24B + LogReg 3K

# ───────────────────────────────────────────────────────────────────────
#  NIVEAU 0 : FILTRE INSTANTANE (le coeur CPU-native)
# ───────────────────────────────────────────────────────────────────────

[niveau0]
role = "Repondre SANS le LLM : maths directes + cache semantique"
calcul_direct = "regex + eval AST securise (jamais eval()), < 1 ms"
calculs_supported = ["carre", "racine", "puissance (exp<=64)", "pourcentage", "arithmetique + - * / %"]
garde_fou = "puissance max 1e15, AST : aucun appel possible"
cache_semantique = "TF-IDF char 2-4 grams + cosinus >= 0.85 -> reponse memorisee"
cache_fichier = ".cache_reponses.jsonl"
cache_taux_hit_vise = "60-70% des questions quotidiennes"
mesures_reelles = "calculs : 0.1-5 ms | question repetee : 1.3 ms (vs 9.8s) = x7500"
fichier = "aura/filtre_instantane.py"

# ───────────────────────────────────────────────────────────────────────
#  CERVEAU UNIQUE : LLAMA 3.2 1B INSTRUCT (Q4_K_M)
# ───────────────────────────────────────────────────────────────────────

[cerveau.llama]
id_huggingface = "bartowski/Llama-3.2-1B-Instruct-GGUF"
fichier_gguf = "modeles/Llama-3.2-1B-Instruct-Q4_K_M.gguf"
architecture = "Transformer decodeur, instruction-tuned (Meta)"
quantification = "Q4_K_M (4 bits, ~807 Mo)"
parametres = "1 240 000 000"
specialite = ["langage", "raisonnement", "conversation", "synthese"]
moteur = "llama.cpp (llama-cpp-python)"
vitesse_cpu = "9-14 tok/s"
chargement = "3.4 s"
ram_requise = "~1.2 Go"
contexte = 1024           # CPU-native : prefill x2 vs 2048
batch = 512
temperature = 0.4          # faible variance : ancre sur les faits
top_p = 0.9
min_p = 0.05               # coupe la queue -> moins de tokens
penalite_repetition = 1.1
threads = "tous les coeurs (6) : +26% vs coeurs physiques seuls"
max_tokens = 220
fichier = "aura/llama_cerveau.py"

[cerveau.llama.prompt]
systeme = "Tu es Aura, une IA francophone et anglophone precise et concise. Reponds en francais si la question est en francais, en anglais sinon. 2 phrases maximum sauf demande explicite. Utilise uniquement les faits fournis ci-dessous s'ils sont presents ; si tu ne sais pas, dis-le."
format_sections = "QUESTION / CORRECTIONS / WEB / FORMULE (injectees au besoin)"

# ───────────────────────────────────────────────────────────────────────
#  EXPERT SYMBOLIQUE : PGS (maths exactes)
# ───────────────────────────────────────────────────────────────────────

[expert_symbolique]
moteur = "gplearn GeneticProgramming"
type = "Regression symbolique par programmation genetique"
operateurs = ["add", "sub", "mul", "div", "pow"]
pow_protege = true  # exposant borne [-5,5], |x|, inf/nan -> 1.0
normalisation = "min-max bidirectionnelle (X et y -> [0,1])"
population = 1500
generations = 20
stopping_criteria = 0.001
precision_garantie = "erreur ~0 sur donnees propres"
garantie = "zero hallucination (formule verifiable)"
vitesse = "instantane (< 20s pour 6 points)"
fichier = "aura/expert_symbolique.py"

# ───────────────────────────────────────────────────────────────────────
#  MEMOIRE WEB : DuckDuckGo (faits en temps reel)
# ───────────────────────────────────────────────────────────────────────

[memoire_web]
moteur = "DuckDuckGo"
package = "ddgs"
cle_api = "aucune"
max_resultats = 3
timeout = 10
offline_fallback = true
format_sortie = "Titre : {title} | Extrait : {body}"
fichier = "aura/memoire_web.py"

# ───────────────────────────────────────────────────────────────────────
#  ROUTEUR INTELLIGENT
# ───────────────────────────────────────────────────────────────────────

[routeur]
moteur = "TF-IDF + LogisticRegression"
fallback = "mots-cles"
nb_exemples = 150
features = "char n-grams (2-4), max_features=2000"
cache = ".cache_routeur/"
fichier = "aura/routeur.py"

[routeur.categories]
math = "equations, formules, calculs, lois, patterns numeriques"
web = "actualites, faits, prix, meteo, records, decouvertes"
general = "conversation, explications, conseils, opinions"

# ───────────────────────────────────────────────────────────────────────
#  AUTO-AMELIORATION
# ───────────────────────────────────────────────────────────────────────

[autoamelioration]
fichier_stockage = ".cache_corrections.jsonl"
methode = "RAG sur corrections (pas de fine-tuning)"
injection_prompt = true
seuil_similarite = 0.2
max_corrections = 3
fichier = "aura/autoamelioration.py"

# ───────────────────────────────────────────────────────────────────────
#  ROUTING : quels experts pour quelle question
# ───────────────────────────────────────────────────────────────────────

[routing]
regles = """
QUESTION → NIVEAU 0 (filtre instantane, < 5 ms)
  ├── maths directe (carre, racine, %, arith)  → reponse EXACTE, stop
  └── cache semantique (sim >= 0.85)           → reponse memorisee, stop

sinon → ROUTEUR (TF-IDF + cosinus)
  ├── "math"    → PGS (erreur 0) + Llama (explique)
  ├── "web"     → DuckDuckGo (faits) + Llama (synthetise)
  └── "general" → Llama (repond)  → reponse ajoutee au cache
"""

# ───────────────────────────────────────────────────────────────────────
#  PARAMETRES TOTAUX
# ───────────────────────────────────────────────────────────────────────

[parametres]
llama_3_2_1b = "1 240 000 000"
routeur_logreg = "3 000"
pgs_gplearn = "0"  # pas de poids neuronaux
total = "1 243 000 000"

[parametres.comparaison]
vs_ancien_moe = "Mamba 790M + RWKV 430M (1.22B) remplaces : +7x vitesse, FR/EN instruction-tuned"
vs_qwen_1_5b = "82% de la taille, + maths exactes + web temps reel + apprentissage"

# ───────────────────────────────────────────────────────────────────────
#  FICHIERS DU SYSTEME
# ───────────────────────────────────────────────────────────────────────

[fichiers]
orchestrateur = "aura/orchestrateur.py"
niveau0 = "aura/filtre_instantane.py"
llama = "aura/llama_cerveau.py"
expert = "aura/expert_symbolique.py"
web = "aura/memoire_web.py"
routeur = "aura/routeur.py"
autoamelioration = "aura/autoamelioration.py"
cli = "aura/__main__.py"
init = "aura/__init__.py"
telechargeur = "scripts/telecharger_llama.py"
pyproject = "pyproject.toml"
tests = "tests/"

# ───────────────────────────────────────────────────────────────────────
#  COMMANDES
# ───────────────────────────────────────────────────────────────────────

[commandes]
install_modele = "python scripts/telecharger_llama.py"
demo = "uv run python -m aura --demo"
question = "uv run python -m aura 'ta question'"
corrections = "uv run python -c 'from aura.autoamelioration import stats; print(stats())'"
tests = "uv run python -m pytest tests/ -q"
